#include <dt-bindings/gpio/gpio.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_capslock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <1 10>;
            timeout-ms = <100>;
            layers = <0>;
        };

        combo_a_f_space {
            bindings = <&kp SPACE>;
            key-positions = <13 16>;
            slow-release;
            layers = <0>;
            timeout-ms = <70>;
            require-prior-idle-ms = <60>;
        };

        combo_a_d_shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <13 15>;
            slow-release;
            layers = <0>;
            timeout-ms = <70>;
            require-prior-idle-ms = <60>;
        };
    };

    macros {
        notification_center_macro: notification_center_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp N>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "NOTIFICATION_CENTER_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp GRAVE   &kp Q  &kp W  &kp E         &kp R         &kp T           &kp Y        &kp U    &kp I            &kp O    &kp P     &kp BSPC
&kp ESCAPE  &kp A  &kp S  &kp D         &kp F         &kp G           &kp H        &kp J    &kp K            &kp L    &kp SEMI  &kp SQT
&kp LCTRL   &kp Z  &kp X  &kp C         &kp V         &kp B           &kp N        &kp M    &kp COMMA        &kp DOT  &kp FSLH  &kp RS(RA(RC(RIGHT_GUI)))
                          &kp LEFT_ALT  &kp LEFT_GUI  &lt 2 RETURN    &lt 1 SPACE  &kp TAB  &kp RIGHT_SHIFT
            >;
        };

        numbers {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none       &kp N1        &kp N2        &kp N3        &kp N4        &kp N5          &kp N6        &kp N7        &kp N8            &kp N9         &kp N0  &kp BSPC
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp LEFT      &kp DOWN      &kp UP            &kp RIGHT      &none   &none
&none       &none         &none         &none         &none         &none           &kp RS(LEFT)  &kp RS(DOWN)  &kp RS(UP_ARROW)  &kp RS(RIGHT)  &none   &none
                                        &trans        &trans        &kp SPACE       &kp RET       &none         &none
            >;
        };

        symbols {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp EXCL  &kp AT          &kp HASH  &kp DLLR              &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&trans  &trans    &trans          &trans    &lt 3 K_CONTEXT_MENU  &none        &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &none
&trans  &trans    &studio_unlock  &trans    &trans                &trans       &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &none
                                  &trans    &trans                &trans       &trans     &trans     &trans
            >;
        };

        functions {
            bindings = <
&none  &none  &none                 &none  &none  &none    &none                       &none  &kp K_VOLUME_DOWN     &kp K_VOLUME_UP       &none  &none
&none  &none  &kp LG(LS(NUMBER_4))  &none  &none  &none    &none                       &none  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none  &none
&none  &none  &none                 &none  &none  &none    &notification_center_macro  &none  &none                 &none                 &none  &none
                                    &none  &none  &none    &none                       &none  &none
            >;
        };
    };
};

&nice_view_spi { cs-gpios = <&pro_micro 8 GPIO_ACTIVE_HIGH>; };
